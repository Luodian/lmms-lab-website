---
import BaseHead from "@/components/BaseHead.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import PixelWorldWrapper from "@/components/game/PixelWorldWrapper.astro";
import { siteConfig } from "@/site.config";
---

<html lang={siteConfig.lang}>
	<head>
		<BaseHead 
			title="LMMs-Lab Farm - Interactive Research Portal" 
			description="Explore LMMs-Lab research in a Stardew Valley inspired pixel world. Navigate through Models, Tools, and Research areas." 
		/>
		<style>
			body {
				margin: 0;
				padding: 0;
				overflow: hidden;
			}
		</style>
	</head>
	<body class="bg-[#1a1a2e]">
		<ThemeProvider />
		<PixelWorldWrapper />
	</body>
</html>
